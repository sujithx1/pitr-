[db]
pg1-path=/var/lib/postgresql/18/docker
pg1-user=${POSTGRES_USER}
pg1-database=${POSTGRES_DB}

[global]
# Cloud Storage Provider (S3 / MinIO / GCS S3 API)
repo1-type=s3
repo1-s3-bucket=${S3_BUCKET_NAME}
repo1-s3-region=${S3_REGION}
repo1-s3-endpoint=${S3_ENDPOINT}
repo1-s3-key=${S3_ACCESS_KEY}
repo1-s3-key-secret=${S3_SECRET_KEY}

# Client-Side AES-256 Encryption
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${ENCRYPTION_PASSPHRASE}

# Enterprise Backup Retention & Performance
repo1-retention-full=2
compress-type=zst
start-fast=y
log-level-console=info
log-level-file=detail
